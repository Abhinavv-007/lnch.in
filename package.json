{
  "name": "lnch.in",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "lnch.in — public launch hub + LaunchOps private command center.",
  "scripts": {
    "dev": "vite",
    "dev:functions": "wrangler pages dev -- vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply launchops-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply launchops-db --remote",
    "db:seed:local": "wrangler d1 execute launchops-db --local --file=seeds/seed_projects.sql",
    "db:seed:remote": "wrangler d1 execute launchops-db --remote --file=seeds/seed_projects.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "wrangler": "^4.88.0"
  }
}
